#! /bin/bash


# Import color
source $AV_CONFIG_DIR/default_imports

# Check for a help flag
avCheckHelpFlags "$1" "berglas9" "Build the berglas9 binary" "\n\
Usage:\n\
    make\n\
\n\
Builds ./berglas9 with trimpath.\n\
\n"

# Import system path
avAppendSystemPath

#### Put system commands here

cd "$AV_PROJ_TOP"
set -e

go build -trimpath -o berglas9 ./cmd/berglas9

#### End commands
