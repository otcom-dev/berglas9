#! /bin/bash


# Import color
source $AV_CONFIG_DIR/default_imports

# Check for a help flag
avCheckHelpFlags "$1" "berglas9" "Install berglas, gox, and the Homebrew link" "\n\
Usage:\n\
    setup\n\
\n\
Installs the berglas CLI and gox into the Go bin directory.\n\
berglas matches the module version. gox is used by av release.\n\
Links ./homebrew to ../homebrew-tap when that link is missing.\n\
\n"

# Import system path
avAppendSystemPath

#### Put system commands here

cd "$AV_PROJ_TOP"
set -e

bindir="$(go env GOBIN)"
if [ -z "$bindir" ]; then
	bindir="$(go env GOPATH)/bin"
fi
export PATH="$bindir:$PATH"

echo "Installing berglas v1.0.3..."
go install github.com/GoogleCloudPlatform/berglas@v1.0.3

echo "Installing gox v1.0.1..."
go install github.com/mitchellh/gox@v1.0.1

echo "Installed to ${bindir}"
echo "  berglas: ${bindir}/berglas"
echo "  gox:     ${bindir}/gox"

link="homebrew"
target="../homebrew-tap"
if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
	echo "homebrew already links to ${target}"
else
	if [ -e "$link" ] && [ ! -L "$link" ]; then
		echo "homebrew exists and is not a symlink. Remove it, then run av setup again." >&2
		exit 1
	fi
	ln -sfn "$target" "$link"
	echo "Linked ${link} -> ${target}"
fi

#### End commands
