#! /bin/bash


# Import color
source $AV_CONFIG_DIR/default_imports

# Check for a help flag
avCheckHelpFlags "$1" "berglas9" "Stamp the release version into the binary" "\n\
Usage:\n\
    update-version\n\
\n\
Reads the version from tools/install.sh and writes it into cmd/berglas9/main.go.\n\
\n"

# Import system path
avAppendSystemPath

#### Put system commands here

cd "$AV_PROJ_TOP"
set -e

version="$(./tools/version.sh)"
file="cmd/berglas9/main.go"
expr="s/\"v[0-9][0-9]*\\.[0-9][0-9]*\\.[0-9][0-9]*\"/\"${version}\"/"

if sed --version >/dev/null 2>&1; then
	sed -i "$expr" "$file"
else
	sed -i '' "$expr" "$file"
fi

echo "Stamped ${version} into ${file}"

#### End commands
